
config interface 'loopback'
	option device 'lo'
	option proto 'static'
	list ipaddr '127.0.0.1/8'

config globals 'globals'
	option dhcp_default_duid '000497a9ec769b594680abd7b9bd31633e63'

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'lan1'
	list ports 'lan2'
	list ports 'lan3'
	list ports 'lan4'
	list ports 'lan5'

config interface 'lan'
	option device 'br-lan.10'
	option proto 'static'
	list ipaddr '10.10.10.1/24'
	option delegate '0'

config interface 'wan'
	option device 'eth1'
	option proto 'dhcp'

config bridge-vlan 'vlan10'
	option device 'br-lan'
	option vlan '10'
	list ports 'lan1:t'
	list ports 'lan2:u*'

config bridge-vlan 'vlan20'
	option device 'br-lan'
	option vlan '20'
	list ports 'lan1:t'
	list ports 'lan3:u*'

config bridge-vlan 'vlan30'
	option device 'br-lan'
	option vlan '30'
	list ports 'lan1:t'
	list ports 'lan4:u*'

config bridge-vlan 'vlan40'
	option device 'br-lan'
	option vlan '40'
	list ports 'lan1:t'

config bridge-vlan 'vlan50'
	option device 'br-lan'
	option vlan '50'
	list ports 'lan1:t'
	list ports 'lan5:u*'

config bridge-vlan 'vlan60'
	option device 'br-lan'
	option vlan '60'
	list ports 'lan1:t'

config bridge-vlan 'vlan70'
	option device 'br-lan'
	option vlan '70'
	list ports 'lan1:t'

